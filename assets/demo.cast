{"version": 2, "width": 120, "height": 45, "timestamp": 1794134073, "env": {"SHELL": "/bin/sh", "TERM": "xterm-256color"}, "title": "truemsg: actual synthetic CLI / labelled field views"}
[0.288564, "o", "=== CASE: matching ===\r\n$ git show --format= --no-ext-diff --no-textconv -U0 HEAD\r\ndiff --git a/src/auth.py b/src/auth.py\r\nnew file mode 100644\r\nindex 0000000..41969e0\r\n--- /dev/null\r\n+++ b/src/auth.py\r\n@@ -0,0 +1,2 @@\r\n+def authenticate(token):\r\n+    return bool(token)\r\n"]
[0.288962, "o", "$ truemsg check --json\r\n[JSON field view; full stdout in showcase-raw.json]\r\nverdict: \"PASS\"\r\nmessage: {\"type\": \"feat\", \"subject\": \"add authenticate token handler\", \"breaking\": false}\r\nrule_ids: [\"consistent\"]\r\nsummary: {\"files\": 1, \"added\": 2, \"removed\": 0}\r\nevidence: {\"semantic_verified\": false, \"keywords_available\": true}\r\n[exit 0]\r\n"]
[0.466003, "o", "=== CASE: mismatch ===\r\n$ git show --format= --no-ext-diff --no-textconv -U0 HEAD\r\ndiff --git a/tests/test_payments.py b/tests/test_payments.py\r\nnew file mode 100644\r\nindex 0000000..88c6672\r\n--- /dev/null\r\n+++ b/tests/test_payments.py\r\n@@ -0,0 +1,2 @@\r\n+def test_payments():\r\n+    assert True\r\n"]
[0.466082, "o", "$ truemsg check --json\r\n"]
[0.466139, "o", "[JSON field view; full stdout in showcase-raw.json]\r\nverdict: \"FAIL\"\r\nmessage: {\"type\": \"feat\", \"subject\": \"add payment gateway\", \"breaking\": false}\r\nrule_ids: [\"trivial-change\"]\r\nsummary: {\"files\": 1, \"added\": 2, \"removed\": 0}\r\nevidence: {\"semantic_verified\": false, \"keywords_available\": true}\r\n[exit 1]\r\n"]
[0.576679, "o", "=== CASE: evidence ===\r\n"]
[0.576756, "o", "$ truemsg check --ref 'HEAD~1' --title 'fix: 修复支付漏洞' --json --fail-on warn\r\n"]
[0.576777, "o", "[JSON field view; full stdout in showcase-raw.json]\r\nverdict: \"WARN\"\r\nmessage: {\"type\": \"fix\", \"subject\": \"修复支付漏洞\", \"breaking\": false}\r\nrule_ids: [\"insufficient-keywords\"]\r\nsummary: {\"files\": 1, \"added\": 2, \"removed\": 0}\r\nevidence: {\"semantic_verified\": false, \"keywords_available\": false}\r\n[exit 1]\r\n"]
[0.811911, "o", "=== CASE: suggest ===\r\n"]
[0.81199, "o", "$ truemsg suggest --ref 'HEAD~1' --json\r\n[JSON field view; full stdout in showcase-raw.json]\r\ntype: \"feat\"\r\nscope: \"src\"\r\nsubject: \"add authenticate\"\r\nconventional: \"feat(src): add authenticate\"\r\nrequires_review: true\r\nbasis: \"changed paths and declarations; suggested type is provisional\"\r\n[exit 0]\r\n"]
[0.890765, "o", "=== CASE: hooks ===\r\n$ truemsg hook --install\r\n"]
[0.890837, "o", "[truemsg] Existing hook is not owned by truemsg; preserve it and integrate manually\r\n[exit 2]\r\n"]
[0.890894, "o", "[showcase assertion] existing hook bytes unchanged: true\r\n"]
[0.946268, "o", "=== CASE: git-boundary ===\r\n"]
[0.946328, "o", "$ truemsg check --ref=--output=unexpected.patch --json\r\n[truemsg] Invalid revision: expected a commit ref, not an option\r\n[exit 2]\r\n"]
[0.946377, "o", "[showcase assertion] unexpected.patch absent: true\r\n"]
